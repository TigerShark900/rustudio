 check("global:"..n,function() local f=getfenv()[n]; if n=="loadstring" then return typeof(f) end; return f() end)
end
local function ident(n) print("SECIDENT|"..context.."|"..n); printidentity(); check("inherit:"..n,settings) end
for _,n in {"spawn","defer","delay"} do if n=="delay" then task.delay(0,ident,n) else task[n](ident,n) end end
