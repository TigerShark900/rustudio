local side=game:GetService('RunService'):IsServer() and 'server' or 'client'
local function out(k,...) local a={...}; for i=1,select('#',...) do a[i]=tostring(select(i,...)) end print('BRIDGE|'..side..'|'..k..'|'..table.concat(a,'|')) end
local function test(k,f) local r=table.pack(pcall(f)); out(k,table.unpack(r,1,r.n)) end
local function info(k,f) test(k,function() local s,l,n,a,v=debug.info(f,'slna'); return type(f),s,l,n,a,v,tostring(f) end) end
local function capture(f) local mm; xpcall(f,function() mm=debug.info(2,'f') end); return mm end
local p=Instance.new('Part'); local pl=game:GetService('Players'):GetPlayers()[1]; while not pl do task.wait(); pl=game:GetService('Players'):GetPlayers()[1] end
local sig=p.Changed; local conn=sig:Connect(function() end)
local objects={game=game,part=p,player=pl,enums=Enum,enum=Enum.Material,item=Enum.Material.Plastic,signal=sig,connection=conn}
for name,o in pairs(objects) do
 test(name..'.meta',function() return getmetatable(o),typeof(o),type(o),tostring(o) end)
 local idx=capture(function() return o.____________ end)
 local ni=capture(function() o.____________=true end)
 local nc=capture(function() o:____________() end)
 for kind,f in pairs({index=idx,newindex=ni,namecall=nc}) do
  info(name..'.'..kind,f)
  test(name..'.'..kind..'.empty',function() return f() end)
  test(name..'.'..kind..'.self',function() return f(o) end)
  test(name..'.'..kind..'.table',function() return f(o,{}) end)
  test(name..'.'..kind..'.nil',function() return f(o,nil) end)
 end
 test(name..'.index.nil',function() return o[nil] end)
 test(name..'.index.number',function() return o[1] end)
 test(name..'.write.nil',function() o[nil]=1 end)
 test(name..'.unknown',function() return o:____________() end)
end
local i1=capture(function() return game.____________ end)
local i2=capture(function() return p.____________ end)
local i3=capture(function() return pl.____________ end)
out('index.identity',i1==i2,i2==i3)
for _,case in ipairs({{'unknown',function() game:XYZ() end},{'wrongcase',function() return game:getservice('Players') end},{'propertycall',function() workspace:Name() end},{'eventcall',function() p:Changed() end},{'readonly',function() p.ClassName='X' end},{'wrongtype',function() p.Anchored={} end},{'name.table',function() p.Name={} end},{'parent.number',function() p.Parent=3 end}}) do test(case[1],case[2]) end
local methods={{game,'GetService'},{p,'WaitForChild'},{Instance.new('BindableFunction'),'Invoke'},{Instance.new('RemoteFunction'),'InvokeServer'},{Instance.new('RemoteFunction'),'InvokeClient'},{Enum,'GetEnums'},{Enum.Material,'GetEnumItems'},{Enum.Material,'FromName'},{Enum.Material,'FromValue'},{Enum.Material.Plastic,'IsA'},{sig,'Connect'},{conn,'Disconnect'},{game:GetService('Debris'),'AddItem'},{game:GetService('PhysicsService'),'GetMaxCollisionGroups'}}
for _,m in ipairs(methods) do local o,k=m[1],m[2]; test(k..'.inspect',function() local f=o[k]; info(k..'.info',f); out(k..'.identity',f==o[k]); return true end); test(k..'.noself',function() return o[k]() end); test(k..'.wrongself',function() return o[k]({}) end); test(k..'.wrongclass',function() return o[k](workspace) end) end
for _,v in ipairs({{},true,3}) do test('GetService.arg.'..type(v),function() return game:GetService(v) end) end
test('GetService.missing',function() return game:GetService() end)
test('GetService.crossidentity',function() return game.GetService==workspace.GetService end)
for _,k in ipairs({'Name','Value','EnumType','XYZ'}) do test('item.'..k,function() return Enum.Material.Plastic[k] end); test('item.write.'..k,function() Enum.Material.Plastic[k]=3 end) end
test('enum.fromname',function() return Enum.Material:FromName('Plastic') end)
test('enum.fromvalue',function() return Enum.Material:FromValue(256) end)
test('enum.compare',function() return Enum.Material.Plastic==Enum.Material.Plastic,Enum.Material==Enum.Material,Enum.Material.Plastic<Enum.Material.Wood end)
out('DONE')

