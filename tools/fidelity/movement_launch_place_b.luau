-- Generated by make_movement_place.py: the movement probe for place_b's own
-- character, as a LocalScript in PlayerScripts (both engines).
local me = game:GetService("Players").LocalPlayer
local ls = Instance.new("LocalScript")
ls.Name = "MovementProbe"
ls.Source = [==[local FID_CFG = { origin = Vector3.new(-207.5, -0.37, 119.05), segments = { "walk_stop", "sprint", "turn90", "turn180", "jump_stand", "jump_run", "jump_low", "jump_power" } }
-- Round 22's movement probe, a LocalScript run the same way in both engines
-- (it sits in StarterPlayerScripts of the movement place, or is put in
-- PlayerScripts by movement_launch.luau in a game). For each segment it
-- puts the character at the segment's start, lets it settle, then drives
-- Humanoid:Move / Jump from a fixed program and records every frame after
-- physics (Heartbeat): time, root position (from the lane origin), root
-- velocity, facing, Humanoid state, FloorMaterial and MoveDirection, plus
-- the state changes. Each segment prints FIDMOVE_<name>|i|n|<json chunk>;
-- the end prints FIDMOVEDONE|<json>.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local me = Players.LocalPlayer
local char = me.Character or me.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local root = char:WaitForChild("HumanoidRootPart")

-- The game's own controls would overwrite Humanoid:Move every frame.
pcall(function()
	require(me:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)):GetControls():Disable()
end)

-- In a game (movement_launch_*.luau puts a `local FID_CFG = {...}` line
-- before this source): `segments` = only these, `origin` = where every
-- segment starts (a flat spot by its spawn), or `inplace` = no teleport,
-- each segment measured from where the character is (Place C's ship);
-- `skip` = all but these.
local cfg = FID_CFG or {}
local only = cfg.segments
local skip = cfg.skip or {}
local origin = cfg.origin
local inplace = cfg.inplace

local course = workspace:FindFirstChild("Course")
if not origin and not inplace then
	course = workspace:WaitForChild("Course", 30)
	while course and not course:GetAttribute("Ready") do
		task.wait(0.1)
	end
end
local laneX = {}
if course and course:GetAttribute("Lanes") then
	local i = 0
	for name in string.gmatch(course:GetAttribute("Lanes"), "[^,]+") do
		i += 1
		laneX[name] = i * course:GetAttribute("LaneWidth")
	end
end

local FWD = Vector3.new(0, 0, -1)
local RIGHT = Vector3.new(1, 0, 0)
local STAND = 3.5 -- root height to drop from at a start

local function hold(dir)
	return function()
		return dir, false
	end
end
local function walkThen(dir, untilT)
	return function(t)
		return if t < untilT then dir else Vector3.zero, false
	end
end
local function jumpAt(tj, dir)
	return function(t)
		return dir or Vector3.zero, t >= tj and t < tj + 0.05
	end
end

-- name, duration, program(t) -> (move, jump), optional setup(origin), start offset (x, y, z)
local segments = {
	{ "walk_stop", 3, walkThen(FWD, 1.5) },
	{ "sprint", 2.5, walkThen(FWD, 1.5), function() hum.WalkSpeed = 32 end },
	{ "turn90", 2.2, function(t) return if t < 1 then FWD else RIGHT, false end },
	{ "turn180", 2.2, function(t) return if t < 1 then FWD else -FWD, false end },
	{ "jump_stand", 1.6, jumpAt(0.1) },
	{ "jump_run", 2, jumpAt(0.6, FWD) },
	{ "jump_power", 2, jumpAt(0.1), function() hum.UseJumpPower = true; hum.JumpPower = 80 end },
	{ "jump_low", 1.4, jumpAt(0.1), function() hum.UseJumpPower = false; hum.JumpHeight = 3 end },
	{ "ledge", 2.5, hold(FWD), nil, Vector3.new(0, 8, 0) },
	{ "step_05", 2, hold(FWD) },
	{ "step_10", 2, hold(FWD) },
	{ "step_15", 2, hold(FWD) },
	{ "step_20", 2, hold(FWD) },
	{ "step_25", 2, hold(FWD) },
	{ "step_30", 2, hold(FWD) },
	{ "ramp_30", 3, hold(FWD) },
	{ "ramp_45", 3, hold(FWD) },
	{ "ramp_60", 3, hold(FWD) },
	{ "ramp_75", 3, hold(FWD) },
	{ "ramp_85", 3, hold(FWD) },
	{ "wall_slide", 2, hold((FWD + RIGHT).Unit) },
	{ "corner", 2, hold((FWD + RIGHT).Unit) },
	{ "thin_wall", 2, hold(FWD) },
	{ "gap_16", 2, hold(FWD) },
	{ "gap_22", 2, hold(FWD) },
	{ "gap_30", 2, hold(FWD) },
	{ "ceiling_walk", 2.5, hold(FWD) },
	{ "ceiling_jump", 1.6, jumpAt(0.1) },
	{ "truss", 3.5, walkThen(FWD, 2.5) },
	{ "seat", 3.5, function(t) return if t < 1.5 then FWD else Vector3.zero, t >= 2.5 and t < 2.55 end },
	{ "vehicle_seat", 3.5, function(t) return if t < 1.5 then FWD else Vector3.zero, t >= 2.5 and t < 2.55 end },
	{ "conveyor", 2.5, hold(Vector3.zero), nil, Vector3.new(0, 1, -2) },
	{ "spinner", 3, hold(Vector3.zero), nil, Vector3.new(6, 1, 0) },
	{ "tween_platform", 3.5, hold(Vector3.zero), function(o)
		local p = course and course:FindFirstChild("TweenPlatform")
		if p then
			p.CFrame = CFrame.new(o + Vector3.new(0, 3, 0))
			TweenService:Create(p, TweenInfo.new(3, Enum.EasingStyle.Linear), { CFrame = CFrame.new(o + Vector3.new(0, 3, -20)) }):Play()
		end
	end, Vector3.new(0, 3.5, 0) },
	{ "slippery", 3, walkThen(FWD, 1), nil, Vector3.new(0, 1, 0) },
	{ "friction_001", 3, walkThen(FWD, 1), nil, Vector3.new(0, 1, 0) },
	{ "friction_005", 3, walkThen(FWD, 1), nil, Vector3.new(0, 1, 0) },
	{ "friction_02", 3, walkThen(FWD, 1), nil, Vector3.new(0, 1, 0) },
	{ "friction_w1", 3, walkThen(FWD, 1), nil, Vector3.new(0, 1, 0) },
	-- Round 23: jump into a wall holding forward (it hung there in rustudio).
	{ "wall_jump", 2.5, jumpAt(0.35, FWD) },
	{ "wall_jump_diag", 2.5, jumpAt(0.35, (FWD + RIGHT * 0.5).Unit) },
	{ "grippy", 3, walkThen(FWD, 1), nil, Vector3.new(0, 1, 0) },
	{ "terrain_30", 3, hold(FWD) },
	{ "terrain_55", 3, hold(FWD) },
	{ "water", 4.5, function(t) return if t < 3.5 then FWD else Vector3.zero, t >= 3.5 and t < 4.3 end },
	{ "push_block", 2.5, hold(FWD) },
	{ "falling_down", 4, function(t)
		if t >= 0.2 and t < 0.25 then
			hum:ChangeState(Enum.HumanoidStateType.FallingDown)
		end
		return Vector3.zero, false
	end },
	{ "platform_stand", 3, function(t)
		hum.PlatformStand = t < 1.5
		return FWD, false
	end },
	{ "edge_stand", 2, hold(Vector3.zero), nil, Vector3.new(-0.3, 4, 0) },
}

local function r3(x)
	return math.floor(x * 1000 + 0.5) / 1000
end

-- The character's own settings (Roblox's defaults on the course).
local base = { hum.WalkSpeed, hum.UseJumpPower, hum.JumpHeight, hum.JumpPower, hum.AutoRotate }

local function reset()
	hum:Move(Vector3.zero, false)
	hum.Jump = false
	hum.WalkSpeed, hum.UseJumpPower, hum.JumpHeight, hum.JumpPower, hum.AutoRotate = table.unpack(base)
	if inplace then
		return -- (a ship: its PlatformStand and state are the game's)
	end
	hum.PlatformStand = false
	if hum.Sit then
		hum.Sit = false
	end
	local st = hum:GetState()
	if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Seated or st == Enum.HumanoidStateType.Swimming
		or st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.PlatformStanding then
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function emit(tag, data)
	local text = HttpService:JSONEncode(data)
	local size = 900 -- (the offline Studio MCP log cuts lines near 950)
	local n = math.ceil(#text / size)
	for i = 1, n do
		print(string.format("%s|%d|%d|%s", tag, i, n, string.sub(text, (i - 1) * size + 1, i * size)))
	end
end

local done = {}
for _, seg in segments do
	local name, dur, program, setup, offset = seg[1], seg[2], seg[3], seg[4], seg[5]
	if (only and not table.find(only, name)) or table.find(skip, name) then
		continue
	end
	local o
	if inplace then
		o = root.Position - Vector3.new(0, STAND, 0)
	elseif origin then
		o = origin
	elseif laneX[name] then
		o = Vector3.new(laneX[name], 0, 0)
	else
		continue
	end
	reset()
	if not inplace then
		local start = o + (offset or Vector3.zero) + Vector3.new(0, STAND, 0)
		char:PivotTo(CFrame.new(start))
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	-- Settle a second (sitting / climbing states from the last lane end).
	local t = os.clock()
	while os.clock() - t < 1 do
		RunService.Heartbeat:Wait()
		hum:Move(Vector3.zero, false)
	end
	if setup then
		setup(o)
	end
	if inplace then
		o = root.Position - Vector3.new(0, STAND, 0)
	end
	local frames, events = {}, {}
	local t0 = os.clock()
	local conn = hum.StateChanged:Connect(function(_, new)
		table.insert(events, { r3(os.clock() - t0), new.Name })
	end)
	local stepConn = RunService.RenderStepped:Connect(function()
		local mv, jump = program(os.clock() - t0)
		hum:Move(mv, false)
		if jump then
			hum.Jump = true
		end
	end)
	local block = course and course:FindFirstChild("PushBlock")
	-- At most 60 samples a second (Studio's Heartbeat runs faster; its
	-- Output log keeps only so many lines).
	local lastT = -1
	while true do
		RunService.Heartbeat:Wait()
		local tt = os.clock() - t0
		if tt > dur then
			break
		end
		if tt - lastT < 1 / 61 then
			continue
		end
		lastT = tt
		local p = root.Position - o
		local v = root.AssemblyLinearVelocity
		local look = root.CFrame.LookVector
		local md = hum.MoveDirection
		local f = { r3(tt), r3(p.X), r3(p.Y), r3(p.Z), r3(v.X), r3(v.Y), r3(v.Z), r3(math.atan2(-look.X, -look.Z)),
			hum:GetState().Name, hum.FloorMaterial.Name, r3(md.X), r3(md.Z), r3(look.Y) }
		if name == "push_block" and block then
			table.insert(f, r3(block.Position.Z - o.Z))
		end
		table.insert(frames, f)
	end
	stepConn:Disconnect()
	conn:Disconnect()
	hum:Move(Vector3.zero, false)
	emit("FIDMOVE_" .. name, { name = name, frames = frames, events = events })
	table.insert(done, name)
end
local parts = {}
for _, d in char:GetDescendants() do
	if d:IsA("BasePart") then
		local rel = root.CFrame:PointToObjectSpace(d.Position)
		table.insert(parts, { d.Name, d.CanCollide, r3(d.Size.X), r3(d.Size.Y), r3(d.Size.Z), r3(rel.X), r3(rel.Y), r3(rel.Z), d.Massless, r3(d.Mass) })
	end
end
emit("FIDMOVEDONE", {
	parts = parts,
	mass = r3(root.AssemblyMass),
	segments = done,
	rig = hum.RigType.Name,
	hipHeight = hum.HipHeight,
	rootSize = { root.Size.X, root.Size.Y, root.Size.Z },
	maxSlope = hum.MaxSlopeAngle,
	gravity = workspace.Gravity,
})
]==]
ls.Parent = me:WaitForChild("PlayerScripts")
