<Item class="LocalScript" referent="6"><Properties><string name="Name">SACamera</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local cam = workspace.CurrentCamera
local at = CFrame.lookAt(Vector3.new(0, 10, 10), Vector3.new(0, 5, -40))
RunService:BindToRenderStep("SACam", Enum.RenderPriority.Last.Value, function()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	cam.CFrame = at
end)
</ProtectedString></Properties></Item>
