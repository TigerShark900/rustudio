<Item class="LocalScript" referent="6"><Properties><string name="Name">SAFarCamera</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local cam = workspace.CurrentCamera
local A = CFrame.lookAt(Vector3.new(0, 20, 20), Vector3.new(0, 20, -100))
local B = CFrame.lookAt(Vector3.new(3000, 20, 0), Vector3.new(3000, 60, -100))
local t0 = os.clock()
RunService:BindToRenderStep("SAFarCam", Enum.RenderPriority.Last.Value, function()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	cam.CFrame = if os.clock() - t0 >= 10 then B else A
end)
</ProtectedString></Properties></Item>
</Item></Item>
