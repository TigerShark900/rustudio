<Item class="LocalScript" referent="7"><Properties><string name="Name">Cam</string><ProtectedString name="Source">local cam = workspace.CurrentCamera
game:GetService("RunService").RenderStepped:Connect(function()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 6, 24), Vector3.new(0, 6, 0))
end)</ProtectedString></Properties></Item>
