<Item class="LocalScript" referent="134"><Properties><string name="Name">CalCamera</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local cam = workspace.CurrentCamera
local at = CFrame.lookAt(Vector3.new(75, 130, 300), Vector3.new(75, 0, 300 - 0.001))
RunService:BindToRenderStep("CalCam", Enum.RenderPriority.Camera.Value + 1, function()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	cam.CFrame = at
end)
</ProtectedString></Properties></Item>
</Item></Item>
