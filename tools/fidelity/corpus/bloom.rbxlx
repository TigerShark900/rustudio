<Item class="LocalScript" referent="17"><Properties><string name="Name">BloomCamera</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local cam = workspace.CurrentCamera
local at = CFrame.new(1000, 50, 0)
RunService:BindToRenderStep("BloomCam", Enum.RenderPriority.Camera.Value + 1, function()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	cam.CFrame = at
end)
</ProtectedString></Properties></Item>
