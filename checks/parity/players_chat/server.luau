-- rustudio --luau server probe (checks/parity/players_chat.md)
-- (--luau runs on the main thread: the probe runs in a task so it can yield.)
task.spawn(function()
local P = game:GetService("Players")
local function t(n, f) local r = table.pack(pcall(f)) local s = {} for i = 1, r.n do s[#s+1] = tostring(r[i]) end print("S " .. n .. " = " .. table.concat(s, " | ")) end
local p = P:GetPlayers()[1]
p.Chatted:Connect(function(m) print("S EV Chatted", m) end)
p.CharacterAppearanceLoaded:Connect(function(c) print("S EV CharacterAppearanceLoaded", c) end)
t("GetJoinData", function() return next(p:GetJoinData()) end)
t("IsVerified", function() return p:IsVerified() end)
t("GetCameraState", function() return p:GetCameraState() end)
t("AddReplicationFocus", function() return p:AddReplicationFocus(workspace:FindFirstChildWhichIsA("BasePart")) end)
t("RequestStreamAroundAsync", function() return p:RequestStreamAroundAsync(Vector3.zero) end)
t("LoadNumber", function() return p:LoadNumber("x") end)
t("BanAsync", function() return P:BanAsync({UserIds = {p.UserId}, Duration = 60, DisplayReason = "d", PrivateReason = "pr"}) end)
t("BanAsync bad", function() return P:BanAsync({}) end)
t("BanAsync bad2", function() return P:BanAsync({UserIds = {1}}) end)
t("UnbanAsync", function() return P:UnbanAsync({UserIds = {p.UserId}}) end)
t("GetBanHistoryAsync", function() return P:GetBanHistoryAsync(p.UserId) end)
t("Teams:RebalanceTeams", function() return game:GetService("Teams"):RebalanceTeams() end)
local C = game:GetService("Chat")
t("RegisterChatCallback", function() return C:RegisterChatCallback(Enum.ChatCallbackType.OnServerReceivingMessage, function(m) return m end) end)
t("InvokeChatCallback", function() return type(C:InvokeChatCallback(Enum.ChatCallbackType.OnServerReceivingMessage, {x = 1})) end)
t("InvokeChatCallback none", function() return C:InvokeChatCallback(Enum.ChatCallbackType.OnClientFormattingMessage, {x = 1}) end)
t("FilterStringAsync", function() return C:FilterStringAsync("hello", p, p) end)
local T = game:GetService("TextChatService")
task.wait(0.5)
t("TCS kids", function() local k = {} for _, c in T:GetDescendants() do k[#k+1] = c.Name end table.sort(k) return table.concat(k, ",") end)
local ch = T:FindFirstChild("RBXGeneral", true)
t("SendAsync server", function() return ch:SendAsync("hi") end)
t("AddUserAsync", function() return ch:AddUserAsync(p.UserId) end)
t("SetDirectChatRequester", function() return ch:SetDirectChatRequester(p) end)
t("GetPlayerFromCharacter", function() return P:GetPlayerFromCharacter(p.Character) end)
t("GetUserThumbnailAsync", function() return P:GetUserThumbnailAsync(1, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420) end)
t("props", function() return P.BubbleChat, P.ClassicChat, P.MaxPlayers, P.PreferredPlayers, p.AgeChecked, p.FrustumStreaming end)
local lt = Instance.new("LocalizationTable")
lt:SetEntries({{Key = "greet", Source = "Hi {name}", Context = "", Values = {es = "Hola {name}", fr = "Salut {1}"}}, {Key = "", Source = "Play", Context = "", Values = {es = "Juega"}}})
lt.Parent = game:GetService("LocalizationService")
local tr = lt:GetTranslator("es")
t("FormatByKey", function() return tr:FormatByKey("greet", {name = "Bob"}), tr.LocaleId end)
t("Translate", function() return tr:Translate(workspace, "Play") end)
t("GetString missing", function() return lt:GetString("fr", "zz") end)
t("GetContents", function() return lt:GetContents() end)
t("ForLocale", function() return game:GetService("LocalizationService"):GetTranslatorForLocaleAsync("es"):FormatByKey("greet", {name = "X"}) end)
t("ForPlayerAsync", function() return game:GetService("LocalizationService"):GetTranslatorForPlayerAsync(p) end)
t("GetCountryRegionForPlayerAsync", function() return game:GetService("LocalizationService"):GetCountryRegionForPlayerAsync(p) end)
task.wait(4)
t("LoadCharacter", function() local old = p.Character p:LoadCharacter() return p.Character ~= old end)
-- Login-session lookups (read-only).
t("GetUserIdFromNameAsync", function() return P:GetUserIdFromNameAsync("Roblox") end)
t("GetNameFromUserIdAsync", function() return P:GetNameFromUserIdAsync(1) end)
t("GetNameFromUserIdAsync bad", function() return P:GetNameFromUserIdAsync(9e15) end)
t("IsInGroupAsync", function() return p:IsInGroupAsync(7), p:GetRankInGroupAsync(7), p:GetRoleInGroupAsync(7) end)
t("IsFriendsWithAsync", function() return p:IsFriendsWithAsync(1) end)
t("GetFriendsOnline", function() return #p:GetFriendsOnline(5) end)
t("GetFriendsAsync", function() local pg = P:GetFriendsAsync(1) return pg.ClassName, pg.IsFinished, #pg:GetCurrentPage() end)
print("S DONE")
end)
